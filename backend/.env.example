# Copia este archivo como .env y llena los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore) porque tiene claves secretas.

PORT=3000

# Usuario y contraseña del panel de administrador
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# Clave gratuita de Google Gemini: https://aistudio.google.com/apikey
# Si la dejas vacía, el asistente responde con respuestas básicas sin IA.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Dirección del frontend publicado (para CORS). Ej: https://tuusuario.github.io
FRONTEND_URL=*
